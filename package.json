{
  "name": "pretty-aui",
  "version": "0.1.0",
  "description": "A minimal, out-of-the-box ACP chat UI for React and static sites.",
  "type": "module",
  "license": "MIT",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist",
    "docs",
    "src",
    "README.md",
    "LICENSE"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core/index.d.ts",
      "import": "./dist/core/index.js"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "import": "./dist/react/index.js"
    },
    "./standalone": {
      "types": "./dist/standalone.d.ts",
      "import": "./dist/standalone/pretty-aui.js"
    },
    "./styles.css": {
      "types": "./dist/styles.css.d.ts",
      "default": "./dist/styles.css"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "dev": "vite --config examples/react/vite.config.ts",
    "dev:opencode": "node scripts/dev-opencode.mjs",
    "build": "node scripts/clean.mjs && tsc -p tsconfig.esm.json && tsc -p tsconfig.build.json && vite build && node scripts/copy-assets.mjs",
    "format": "prettier --write .",
    "check": "pnpm check:format && pnpm check:types && pnpm test && pnpm check:docs && pnpm check:build && pnpm check:package",
    "check:build": "node scripts/check-build.mjs",
    "check:dist": "node scripts/check-dist.mjs",
    "check:docs": "node scripts/check-docs.mjs",
    "check:format": "prettier --check .",
    "check:package": "pnpm check:dist && publint && attw --pack . --profile esm-only --quiet",
    "check:types": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "test:e2e": "node scripts/test-e2e.mjs --project=chromium",
    "test:e2e:compat": "node scripts/test-e2e.mjs --project=firefox --project=webkit",
    "test:opencode": "pnpm build && node scripts/live-opencode.mjs",
    "prepack": "pnpm build"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "1.4.0",
    "dompurify": "^3.4.14",
    "isomorphic-dompurify": "3.23.0",
    "marked": "^18.0.10",
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "react": "^18.3.0 || ^19.0.0",
    "react-dom": "^18.3.0 || ^19.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.2",
    "@playwright/test": "^1.62.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^26.3.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/coverage-v8": "4.1.11",
    "jsdom": "^27.4.0",
    "preact": "^10.29.8",
    "prettier": "^3.9.0",
    "publint": "^0.3.24",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "typescript": "7.0.2",
    "vite": "^8.2.2",
    "vitest": "^4.1.11",
    "ws": "^8.19.0"
  },
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "packageManager": "pnpm@10.34.0"
}
